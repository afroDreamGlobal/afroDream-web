# ===================================================
# AFRO DREAM GLOBAL — PRODUCTION ENVIRONMENT CONFIG
# ===================================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------
# Supabase Configuration (PostgreSQL & Auth)
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------
# Cloudinary Media Configuration
# ---------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------
# Brevo (Sendinblue) Transactional Email Service
# ---------------------------------------------------
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=notifications@afrodreamglobal.com
BREVO_SENDER_NAME=Afro Dream Global
ADMIN_NOTIFICATION_EMAIL=info@afrodreamglobal.com

# ---------------------------------------------------
# Administrator Bootstrap
# ---------------------------------------------------
ADMIN_DEFAULT_EMAIL=admin@afrodreamglobal.com
ADMIN_DEFAULT_PASSWORD=AfroDream2026!Secure
